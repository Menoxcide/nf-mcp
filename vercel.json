{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, Accept, Mcp-Session-Id"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/glama.json",
      "destination": "/api/well-known-glama"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/tools",
      "destination": "/api/tools"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ]
}
